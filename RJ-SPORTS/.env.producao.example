# ==========================================================
# RJ SPORTS — configuração de PRODUÇÃO (servidor com Docker)
# Copie para .env.producao e preencha. NUNCA envie o .env.producao
# para o Git nem o partilhe.
# ==========================================================

# Domínio da loja (tem de apontar para o IP do servidor — registo DNS "A")
DOMINIO=www.exemplo.co.mz
# Opcional: outro endereço que redireciona para o principal (ex.: sem "www")
DOMINIO_ALTERNATIVO=exemplo.co.mz

# Endereço público completo (usado no sitemap) — igual ao DOMINIO, com https://
SITE_URL=https://www.exemplo.co.mz

# Segredo das sessões do painel — gere um com:
#   docker run --rm node:22-alpine node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Primeira conta do painel (criada no primeiro arranque)
# Palavra-passe forte: 12+ caracteres. Mude-a no painel depois de entrar.
ADMIN_NOME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Só com o site no Vercel e o servidor no Railway (ver README):
# outros endereços do site que podem usar a API, separados por vírgulas
ORIGENS_PERMITIDAS=
# quantos proxies há à frente do servidor (VPS com Caddy = 1; Vercel + Railway = 2)
TRUST_PROXY=1

# Opções
SESSAO_HORAS=8
UPLOAD_MAX_MB=3
BACKUP_MANTER=14
