# ==========================================================
# RJ SPORTS — variáveis de ambiente do backend
# Copie este ficheiro para .env e ajuste os valores.
# ==========================================================

# Ambiente: development ou production
NODE_ENV=development

# Porta do servidor (o site e a API ficam em http://localhost:3000)
PORT=3000

# Base de dados PostgreSQL
# Local: crie uma base "rjsports" no PostgreSQL deste computador.
# No Vercel estas duas variáveis vêm do Neon (Storage → Neon).
DATABASE_URL="postgresql://postgres:PALAVRA-PASSE@localhost:5432/rjsports"
DATABASE_URL_UNPOOLED="postgresql://postgres:PALAVRA-PASSE@localhost:5432/rjsports"

# Segredo para assinar as sessões do painel.
# Use um texto longo e aleatório (ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=mude-isto-para-um-texto-longo-e-aleatorio

# Duração da sessão do painel (em horas)
SESSAO_HORAS=8

# Primeira conta de administrador (criada pelo "npm run db:seed")
# Mude a palavra-passe no painel (Configurações) no primeiro acesso.
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@rjsports.co.mz
ADMIN_PASSWORD=mude-esta-palavra-passe

# Tamanho máximo das fotos enviadas no painel (em MB)
UPLOAD_MAX_MB=3

# Fotos no Vercel Blob (no Vercel: Storage → Blob cria esta variável).
# Vazio = as fotos ficam na pasta backend/uploads (desenvolvimento / Docker).
BLOB_READ_WRITE_TOKEN=
# Tipo do armazenamento Blob no Vercel: private (por omissão) ou public
BLOB_ACESSO=private
