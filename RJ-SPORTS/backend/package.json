{
  "name": "rj-sports-backend",
  "version": "1.0.0",
  "description": "API e servidor da loja RJ Sports (dropshipping em Moçambique, pagamento na entrega)",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --watch src src/server.js",
    "setup": "prisma migrate deploy && node prisma/seed.js",
    "db:migrate": "prisma migrate deploy",
    "db:nova-migracao": "prisma migrate dev --create-only",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "backup": "node scripts/backup.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "prisma": "^6.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
